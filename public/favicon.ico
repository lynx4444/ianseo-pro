<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="1" stdDeviation="1" flood-color="#000000" flood-opacity="0.3"/>
    </filter>
  </defs>
  <!-- Background Plate for visibility across all browser themes -->
  <rect width="64" height="64" rx="14" fill="#0B1120"/>
  
  <!-- Outer Blue Target Ring -->
  <circle cx="32" cy="32" r="24" fill="#0284c7" stroke="#38bdf8" stroke-width="1.5" filter="url(#glow)"/>
  
  <!-- Middle Red Target Ring -->
  <circle cx="32" cy="32" r="16" fill="#dc2626" stroke="#f87171" stroke-width="1.2"/>
  
  <!-- Inner Yellow / Gold Target Ring -->
  <circle cx="32" cy="32" r="8" fill="#eab308" stroke="#fde047" stroke-width="1"/>
  
  <!-- Center 10-Ring Dot -->
  <circle cx="32" cy="32" r="2.5" fill="#ca8a04"/>
  
  <!-- Subtle Crosshairs -->
  <line x1="32" y1="26" x2="32" y2="38" stroke="#78350f" stroke-width="0.75" stroke-linecap="round" opacity="0.6"/>
  <line x1="26" y1="32" x2="38" y2="32" stroke="#78350f" stroke-width="0.75" stroke-linecap="round" opacity="0.6"/>
</svg>
